{
  "manifest_version": 3,
  "name": "页签 WebMarker",
  "version": "1.0.0",
  "description": "对网页进行整页标签分类与备注标注，跨浏览器持久化存储",


  "action": {
    "default_popup": "popup.html",
    "default_title": "页签 WebMarker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "options_page": "options.html",

  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },

  "permissions": [
    "nativeMessaging",

    "activeTab",
    "storage",
    "bookmarks"
  ],

  "host_permissions": [],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}